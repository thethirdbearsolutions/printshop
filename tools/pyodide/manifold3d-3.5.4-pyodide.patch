diff -ru -x .pyodide_build -x .git -x '*.pyc' a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt	2022-11-09 12:37:21.000000000 +0000
+++ b/CMakeLists.txt	2026-10-04 00:53:48.389467771 +0000
@@ -158,7 +158,8 @@
   option(CMAKE_BUILD_TYPE "Build type" RelWithDebInfo)
 endif()
 
-if(EMSCRIPTEN)
+option(MANIFOLD_PYODIDE "Build the Python bindings as a Pyodide extension module" OFF)
+if(EMSCRIPTEN AND NOT MANIFOLD_PYODIDE)
   message("Building for Emscripten")
   add_link_options(-sALLOW_MEMORY_GROWTH=1)
   add_link_options(-sMAXIMUM_MEMORY=4294967296)
diff -ru -x .pyodide_build -x .git -x '*.pyc' a/bindings/CMakeLists.txt b/bindings/CMakeLists.txt
--- a/bindings/CMakeLists.txt	2022-11-09 12:37:21.000000000 +0000
