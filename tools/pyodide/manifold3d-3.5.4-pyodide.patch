diff -ru -x .pyodide_build -x .git -x '*.pyc' a/cmake/manifoldDeps.cmake b/cmake/manifoldDeps.cmake
--- a/cmake/manifoldDeps.cmake	2022-11-09 12:37:21.000000000 +0000
+++ b/cmake/manifoldDeps.cmake	2026-10-04 00:56:10.020340869 +0000
@@ -209,6 +209,11 @@
     message("AddressSanitizer detected, Python stub generation disabled")
   endif()
 
+  if(MANIFOLD_PYODIDE)
+    # stubgen imports the module with the build machine's Python, which cannot load a wasm32 module
+    set(MANIFOLD_PYBIND_STUBGEN OFF)
+  endif()
+
   if(NOT MANIFOLD_USE_BUILTIN_NANOBIND)
     execute_process(
       COMMAND "${Python_EXECUTABLE}" -m nanobind --version
